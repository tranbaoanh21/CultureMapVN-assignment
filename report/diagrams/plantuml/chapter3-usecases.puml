@startuml
!include culturemap-style.puml
left to right direction
skinparam nodesep 10
skinparam ranksep 30
actor "Khách vãng lai" as Guest
actor "Thành viên" as Member
rectangle "CultureMap VN - Khách và thành viên" {
  package "Khám phá" {
    usecase "Tìm và khám phá địa phương\nUC-01" as Discover
    usecase "Đọc bài và xem nguồn\nUC-02" as Read
    usecase "Hỏi về bài đang đọc\nUC-11" as Ask
  }
  package "Tài khoản" {
    usecase "Đăng ký, đăng nhập, đăng xuất\nUC-10" as Auth
  }
  package "Đóng góp và báo cáo" {
    usecase "Gửi đề xuất bài mới\nUC-03" as Contribute
    usecase "Báo bài sai hoặc lỗi thời\nUC-04" as Report
    usecase "Theo dõi kết quả yêu cầu\nUC-08" as Track
  }

}
Guest -- Discover
Guest -- Read
Guest -- Ask
Guest -- Auth
Member -- Discover
Member -- Read
Member -- Ask
Member -- Auth
Member -- Contribute
Member -- Report
Member -- Track
@enduml
